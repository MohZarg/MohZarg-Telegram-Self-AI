# Copy to .env locally. Never commit real credentials.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_SECRET_KEY=replace-with-a-long-random-local-secret
LOG_LEVEL=INFO

# Telegram MTProto application credentials from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Optional administrative Telegram Bot API credentials
TELEGRAM_ADMIN_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# AI provider configuration
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Optional local database
DATABASE_URL=sqlite:///./data/telegram_self_ai.db

# Optional donation URL; leave blank until configured
DONATION_URL=

# IMPORTANT: Telegram adapters and mode selection are not implemented yet.
# Do not treat these names as active settings until code validates them.
# Planned mode values: bot, mtproto, both.
# TELEGRAM_MODE=both
# SESSION_ENCRYPTION_KEY=managed-outside-Git
