# Copy to .env locally. Never commit real credentials.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_SECRET_KEY=replace-with-a-long-random-local-secret
LOG_LEVEL=INFO

# Required when APP_ENV=production. Configure via host secrets, never Git.
# Use a long, unique password and HTTPS reverse proxy before remote access.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Telegram MTProto application credentials from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Optional administrative Telegram Bot API credentials
TELEGRAM_ADMIN_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_ADMIN_USER_ID=

# AI provider configuration
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Optional local database
DATABASE_URL=sqlite:///./data/telegram_self_ai.db
SCHEDULER_DB_PATH=./data/jobs.sqlite3
SCHEDULER_POLL_INTERVAL=1.0

# Optional donation URL; leave blank until configured
DONATION_URL=

# Bot mode starts restricted long polling for this exact admin user and chat.
# MTProto and combined mode remain unavailable until the MTProto adapter is implemented.
TELEGRAM_MODE=disabled
# SESSION_ENCRYPTION_KEY=managed-outside-Git
